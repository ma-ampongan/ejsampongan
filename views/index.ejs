<%- include('partials/header') %>
<h1>Welcome to my Website</h1>

<table border = "1">
	<tr>
		<th>ID</th>
		<th>NAME</th>
		<th>ADDRESS</th>
		<th>EMAIL</th>
	</tr>

	<% users.forEach(user => {%>
	<tr>
	<td><%= user.id% ></td>
	<td><%= user.name %></td>
	<td><%= user.address %></td>
	<td><%= user.email %></td>
	</tr>
	<%}) %>

</table>

<%- include('partials/footer')%>